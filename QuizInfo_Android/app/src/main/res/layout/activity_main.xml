<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D17"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Zone des écrans -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===================== ÉCRAN ACCUEIL ===================== -->
            <ScrollView
                android:id="@+id/screenHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUIZINFO"
                        android:textColor="#FFB400"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.25" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Teste tes connaissances en informatique"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Réponds aux questions, découvre ton pourcentage de réussite en direct et suis ta progression."
                        android:textColor="#9AA0B4"
                        android:textSize="15sp" />

                    <!-- Carte participant -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        app:cardBackgroundColor="#151929"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#272C42"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="22dp"
                            android:paddingTop="18dp"
                            android:paddingEnd="22dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PARTICIPANT"
                                android:textColor="#FFB400"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.2" />

                            <EditText
                                android:id="@+id/etName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:hint="Entre ton nom"
                                android:imeOptions="actionDone"
                                android:inputType="textPersonName"
                                android:maxLength="30"
                                android:paddingTop="12dp"
                                android:paddingBottom="14dp"
                                android:singleLine="true"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#5C6280"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Carte 10 questions -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#FFB400"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="26dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10 questions"
                                android:textColor="#0B0D17"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Matériel · Réseaux · Programmation · Bases de données · Sécurité · Web"
                                android:textColor="#3D2E00"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Carte dernier résultat -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#F5F6FA"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DERNIER RÉSULTAT"
                                android:textColor="#B07A00"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.2" />

                            <TextView
                                android:id="@+id/tvLastResult"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingExtra="2dp"
                                android:text="Aucun quiz effectué pour le moment."
                                android:textColor="#0B0D17"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="30dp"
                        android:backgroundTint="#FFB400"
                        android:text="Commencer le quiz"
                        android:textAllCaps="false"
                        android:textColor="#0B0D17"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistory"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@android:color/transparent"
                        android:text="Voir l'historique"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp"
                        app:strokeColor="#3A4060"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </ScrollView>

            <!-- ===================== ÉCRAN QUIZ ===================== -->
            <ScrollView
                android:id="@+id/screenQuiz"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Question 1 / 10"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDomain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Matériel"
                            android:textColor="#FFB400"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="16dp"
                        android:max="10"
                        android:progress="0"
                        android:progressBackgroundTint="#272C42"
                        android:progressTint="#FFB400"
                        android:indeterminate="false" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        app:cardBackgroundColor="#151929"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#272C42"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="120dp"
                            android:gravity="center_vertical"
                            android:lineSpacingExtra="3dp"
                            android:padding="26dp"
                            android:text="Question"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <RadioGroup
                        android:id="@+id/rgAnswers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rb1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:buttonTint="#FFB400"
                            android:minHeight="58dp"
                            android:padding="18dp"
                            android:text="Réponse A"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/rb2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:buttonTint="#FFB400"
                            android:minHeight="58dp"
                            android:padding="18dp"
                            android:text="Réponse B"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/rb3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:buttonTint="#FFB400"
                            android:minHeight="58dp"
                            android:padding="18dp"
                            android:text="Réponse C"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <RadioButton
                            android:id="@+id/rb4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:buttonTint="#FFB400"
                            android:minHeight="58dp"
                            android:padding="18dp"
                            android:text="Réponse D"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                    </RadioGroup>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="#F5F6FA"
                        app:cardCornerRadius="26dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/tvFeedbackTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Bonne réponse"
                                android:textColor="#15803D"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvFeedbackPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Taux de réussite : 100 %"
                                android:textColor="#B07A00"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvExplanation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:lineSpacingExtra="3dp"
                                android:text="Explication"
                                android:textColor="#1F2333"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAction"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#FFB400"
                        android:text="Valider"
                        android:textAllCaps="false"
                        android:textColor="#0B0D17"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp" />
                </LinearLayout>
            </ScrollView>

            <!-- ===================== ÉCRAN RÉSULTAT ===================== -->
            <ScrollView
                android:id="@+id/screenResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RÉSULTAT FINAL"
                        android:textColor="#FFB400"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.25" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:cardBackgroundColor="#FFB400"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="30dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Score global"
                                android:textColor="#3D2E00"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvFinalPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 %"
                                android:textColor="#0B0D17"
                                android:textSize="64sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvLevel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Débutant"
                                android:textColor="#FFB400"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvScoreDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="0 / 10 bonnes réponses"
                                android:textColor="#3D2E00"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#151929"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#272C42"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/tvCorrect"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#22C55E"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Bonnes réponses"
                                    android:textColor="#9AA0B4"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#151929"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#272C42"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="20dp">

                                <TextView
                                    android:id="@+id/tvWrong"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#EF4444"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Mauvaises réponses"
                                    android:textColor="#9AA0B4"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="DÉTAIL DES QUESTIONS"
                        android:textColor="#FFB400"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />

                    <LinearLayout
                        android:id="@+id/recapList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestart"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="26dp"
                        android:backgroundTint="#FFB400"
                        android:text="Recommencer le questionnaire"
                        android:textAllCaps="false"
                        android:textColor="#0B0D17"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResultHistory"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="@android:color/transparent"
                        android:text="Voir l'historique"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp"
                        app:strokeColor="#3A4060"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResultHome"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="@android:color/transparent"
                        android:text="Retour à l'accueil"
                        android:textAllCaps="false"
                        android:textColor="#9AA0B4"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp"
                        app:strokeColor="#272C42"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </ScrollView>

            <!-- ===================== ÉCRAN HISTORIQUE ===================== -->
            <ScrollView
                android:id="@+id/screenHistory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HISTORIQUE"
                        android:textColor="#FFB400"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.25" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Résultats des participants"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHistoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="Aucun résultat enregistré pour le moment."
                        android:textColor="#9AA0B4"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/historyList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="28dp"
                        android:backgroundTint="@android:color/transparent"
                        android:text="Effacer l'historique"
                        android:textAllCaps="false"
                        android:textColor="#EF4444"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp"
                        app:strokeColor="#5A2429"
                        app:strokeWidth="1.5dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHistoryBack"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:backgroundTint="#FFB400"
                        android:text="Retour"
                        android:textAllCaps="false"
                        android:textColor="#0B0D17"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="31dp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- ===================== BARRE DE NAVIGATION EN BAS ===================== -->
        <!-- 4 onglets : Accueil · Quiz · Résultats · Historique -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151929"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="12dp">

            <!-- Onglet ACCUEIL -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accueil"
                    android:textColor="#FFB400"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Onglet QUIZ -->
            <LinearLayout
                android:id="@+id/navQuiz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Quiz"
                    android:textColor="#9AA0B4"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Onglet RÉSULTATS -->
            <LinearLayout
                android:id="@+id/navResults"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Résultats"
                    android:textColor="#9AA0B4"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Onglet HISTORIQUE -->
            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕘"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Historique"
                    android:textColor="#9AA0B4"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
